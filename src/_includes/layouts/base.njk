<!doctype html>
<html lang="{{ site.seo.locale }}">
<head>
<meta charset="utf-8">
{# viewport-fit=cover lets the hero film reach the edges of the screen, and is
   what makes env(safe-area-inset-*) report anything other than zero. The CSS
   pads the controls back out of the notch and the home indicator. #}
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

{% set pageTitle = title if title else site.business.name %}
{% set pageDesc = description if description else site.seo.defaultDescription %}
{% set canonical = (page.url | absolute(site.seo.url)) %}

<title>{% if title %}{{ title }} · {{ site.business.name }}{% else %}{{ site.business.name }} · {{ site.business.tagline }} in {{ site.contact.address.district }}, {{ site.contact.address.city }}{% endif %}</title>
<meta name="description" content="{{ pageDesc }}">
<meta name="keywords" content="{{ site.seo.keywords | join(', ') }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="theme-color" content="{{ site.brand.colors.ivory }}">
<meta name="robots" content="index, follow">

<!-- Open Graph / social previews -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.business.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:locale" content="{{ site.seo.localeOg }}">
<meta property="og:image" content="{{ site.images.share.src | absolute(site.seo.url) }}">
<meta property="og:image:alt" content="{{ site.images.share.alt }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ site.images.share.src | absolute(site.seo.url) }}">

<link rel="icon" href="{{ "/assets/img/favicon.svg" | url }}" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ "/assets/img/apple-touch-icon.png" | url }}">

<!--
  Brand tokens from src/_data/site.js. These override the defaults in
  identity.css, so that file stays the design system and site.js stays the
  single place to change this site's colours and faces.
-->
<style>
:root {
{%- for key, value in site.brand.colors %}
  --{{ key | kebab }}: {{ value }};
{%- endfor %}
  --font-display: {{ site.brand.fonts.display | safe }};
  --font-ui: {{ site.brand.fonts.body | safe }};
}
</style>
<link rel="preload" href="{{ "/assets/fonts/cormorant-garamond-300-latin.woff2" | url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ "/assets/fonts/manrope-400-latin.woff2" | url }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ "/assets/css/fonts-identity.css" | url }}">
<link rel="stylesheet" href="{{ "/assets/css/identity.css" | url }}">
<link rel="stylesheet" href="{{ "/assets/css/site.css" | url }}">

<!-- Structured data: helps this business appear correctly in search and maps -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{{ site.seo.schemaType }}",
  "name": {{ site.business.name | jsonld | safe }},
  "description": {{ site.business.summary | jsonld | safe }},
  "url": {{ site.seo.url | jsonld | safe }},
  "image": {{ (site.images.share.src | absolute(site.seo.url)) | jsonld | safe }},
  "telephone": {{ site.contact.phone.display | jsonld | safe }},
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ site.contact.address.street | jsonld | safe }},
    "addressLocality": {{ site.contact.address.district | jsonld | safe }},
    "addressRegion": {{ site.contact.address.city | jsonld | safe }},
    "addressCountry": {{ site.contact.address.countryCode | jsonld | safe }}
  },
  "openingHoursSpecification": [
{%- for group in site.hours.groups %}
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": {{ group.days | jsonld | safe }},
      "opens": {{ group.opens | jsonld | safe }},
      "closes": {{ group.closes | jsonld | safe }}
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "sameAs": [{{ site.contact.instagram.link | jsonld | safe }}],
  {% if site.seo.priceRange %}"priceRange": {{ site.seo.priceRange | jsonld | safe }},{% endif %}
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Treatments",
    "itemListElement": [
{%- for category in site.serviceCategories %}
      {
        "@type": "OfferCatalog",
        "name": {{ category.name | jsonld | safe }},
        "itemListElement": [
{%- for service in category.services %}
          {
            "@type": "Offer",
            "itemOffered": { "@type": "Service", "name": {{ service.name | jsonld | safe }} }
          }{% if not loop.last %},{% endif %}
{%- endfor %}
        ]
      }{% if not loop.last %},{% endif %}
{%- endfor %}
    ]
  }
}
</script>
</head>

<body class="no-js{% if bodyClass %} {{ bodyClass }}{% endif %}">
<a class="skip-link" href="#main">Skip to content</a>

{% include "partials/header.njk" %}

<main id="main">
  {{ content | safe }}
</main>

{% include "partials/footer.njk" %}
{% include "partials/booking-bar.njk" %}

<script src="{{ "/assets/js/placeholder-media.js" | url }}" defer></script>
<script src="{{ "/assets/js/main.js" | url }}" defer></script>
</body>
</html>
