<footer class="footer">
  <div class="shell">

    <div class="footer__grid">

      <div class="footer__brand">
        <a class="logo" href="/">
          <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-width="1"/>
            <path d="M16 6c4.4 3.2 6.6 6.6 6.6 10a6.6 6.6 0 0 1-13.2 0C9.4 12.6 11.6 9.2 16 6Z"
                  fill="none" stroke="currentColor" stroke-width="1.2"/>
            <path d="M16 12v9" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.55"/>
          </svg>
          <span class="logo__text">
            <span class="logo__name">{{ site.business.name }}</span>
            <span class="logo__sub">{{ site.business.tagline }}</span>
          </span>
        </a>
        <p class="footer__summary">{{ site.business.summary }}</p>
      </div>

      <div>
        <h2 class="footer__heading">Visit</h2>
        <address class="footer__address">
          {% for line in site.contact.address.lines %}<span>{{ line }}</span>{% endfor %}
        </address>
        <a class="link small" href="{{ site.contact.address.mapsLink }}" target="_blank" rel="noopener">
          Open in Maps
        </a>
      </div>

      <div>
        <h2 class="footer__heading">Hours</h2>
        <dl class="hours hours--stack">
          {% for group in site.hours.groups %}
          <div class="hours__row">
            <dt>{{ group.label }}</dt>
            <dd>{{ group.time }}</dd>
          </div>
          {% endfor %}
        </dl>
      </div>

      <div>
        <h2 class="footer__heading">Contact</h2>
        <ul class="footer__list">
          <li>
            <a href="{{ site.contact.whatsapp.link | whatsapp(site.contact.whatsapp.prefill) }}"
               target="_blank" rel="noopener">WhatsApp {{ site.contact.whatsapp.display }}</a>
          </li>
          <li><a href="{{ site.contact.phone.link }}">Call {{ site.contact.phone.display }}</a></li>
          <li>
            <a href="{{ site.contact.instagram.link }}" target="_blank" rel="noopener">
              Instagram {{ site.contact.instagram.handle }}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="footer__base">
      <p>© {{ site.year }} {{ site.business.name }}</p>
      <nav aria-label="Footer">
        <ul class="footer__nav">
          {% for item in site.nav %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    {% if site.disclaimer.enabled %}
    <p class="footer__disclaimer">{{ site.disclaimer.text }}</p>
    {% endif %}

  </div>
</footer>
