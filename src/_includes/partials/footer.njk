<footer class="site-footer">
  <div class="shell">

    <div class="site-footer__grid">

      <div class="site-footer__brand">
        <p class="site-footer__name">{{ site.business.name }}</p>
        <p class="site-footer__summary">{{ site.business.summary }}</p>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">Visit</h2>
        <address class="site-footer__address">
          {% for line in site.contact.address.lines %}<span>{{ line }}</span>{% endfor %}
        </address>
        <a class="site-footer__link" href="{{ site.contact.address.mapsLink }}" target="_blank" rel="noopener">
          Open in Maps
        </a>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">Hours</h2>
        <dl class="hours hours--stack">
          {% for group in site.hours.groups %}
          <div class="hours__row">
            <dt>{{ group.label }}</dt>
            <dd>{{ group.time }}</dd>
          </div>
          {% endfor %}
        </dl>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">Contact</h2>
        <ul class="site-footer__contacts">
          <li>
            <a href="{{ site.contact.whatsapp.link | whatsapp(site.contact.whatsapp.prefill) }}"
               target="_blank" rel="noopener">
              WhatsApp {{ site.contact.whatsapp.display }}
            </a>
          </li>
          <li><a href="{{ site.contact.phone.link }}">Call {{ site.contact.phone.display }}</a></li>
          <li>
            <a href="{{ site.contact.instagram.link }}" target="_blank" rel="noopener">
              Instagram {{ site.contact.instagram.handle }}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="site-footer__base">
      <p class="site-footer__copy">© {{ site.year }} {{ site.business.name }}</p>
      <nav class="site-footer__nav" aria-label="Footer">
        <ul>
          {% for item in site.nav %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    {% if site.disclaimer.enabled %}
    <p class="site-footer__disclaimer">{{ site.disclaimer.text }}</p>
    {% endif %}

  </div>
</footer>
