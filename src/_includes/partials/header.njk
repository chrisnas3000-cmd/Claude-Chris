<header class="site-header" data-header>
  <div class="shell site-header__inner">

    <a class="wordmark" href="/" aria-label="{{ site.business.name }} — home">
      <svg class="wordmark__mark" viewBox="0 0 34 42" aria-hidden="true" focusable="false">
        <path d="M 0 42 L 0 21.8 C 0 7.4 6.5 0 17 0 C 27.5 0 34 7.4 34 21.8 L 34 42"
              fill="none" stroke="currentColor" stroke-width="2.4"/>
        <circle cx="17" cy="26" r="2.6" fill="currentColor"/>
      </svg>
      <span class="wordmark__text">
        <span class="wordmark__name">{{ site.business.name }}</span>
        <span class="wordmark__tag">{{ site.contact.address.district }} · {{ site.contact.address.city }}</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i></span>
      <span class="nav-toggle__label">Menu</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {% for item in site.nav %}
        <li>
          <a href="{{ item.url }}"
             {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>
      <a class="btn btn--brass site-nav__cta"
         href="{{ site.contact.whatsapp.link | whatsapp(site.contact.whatsapp.prefill) }}"
         target="_blank" rel="noopener">
        Book on WhatsApp
      </a>
    </nav>

  </div>
</header>
