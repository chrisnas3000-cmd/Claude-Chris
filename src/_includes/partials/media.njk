{#
  Renders an image slot.

  If the entry in site.js has a `src`, a real <img> is rendered. If it does
  not, a painted placeholder frame stands in — sized identically, so dropping
  a photograph in later changes nothing about the layout.

  Usage:
    {% from "partials/media.njk" import frame %}
    {{ frame(site.images.hero, 'hero', '4 / 5') }}
#}

{% macro frame(image, id, ratio, eager) %}
  {%- if image.video -%}
    {#
      A card clip. The poster paints first and the video fades in over it once
      it is really playing, so the card is never empty. Nothing is downloaded
      until the card scrolls into view — these sit below the fold, and most
      visitors should not pay for three videos they never reach.

      Decorative and silent: hidden from assistive technology, and the poster
      carries the alt text for anyone the video never reaches.
    #}
    <img class="card__still" src="/assets/img/service-{{ id }}-poster.jpg"
         alt="{{ image.alt }}" loading="lazy" decoding="async"
         {% if ratio %}style="aspect-ratio: {{ ratio }};"{% endif %}>
    <video class="card__video" data-card-video
           data-webm="/assets/video/service-{{ id }}.webm"
           data-mp4="/assets/video/service-{{ id }}.mp4"
           poster="/assets/img/service-{{ id }}-poster.jpg"
           muted loop playsinline preload="none"
           aria-hidden="true" tabindex="-1" disablepictureinpicture></video>
  {%- elif image.src -%}
    <img src="{{ image.src }}" alt="{{ image.alt }}"
         {% if ratio %}style="aspect-ratio: {{ ratio }};"{% endif %}
         {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
         decoding="async">
  {%- else -%}
    {#
      The frame is decorative in the placeholder state — it depicts nothing,
      so announcing the intended photograph's alt text would describe an image
      that is not there. The surrounding copy carries the meaning instead.
    #}
    <canvas data-media="{{ id }}" data-tone="{{ image.tone | default('warm') }}"
            {% if ratio %}style="aspect-ratio: {{ ratio }};"{% endif %}
            role="presentation" aria-hidden="true"></canvas>
  {%- endif -%}
{% endmacro %}
