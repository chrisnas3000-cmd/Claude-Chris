---
layout: layouts/base.njk
permalink: /
bodyClass: page-home
description: "Teena'z Spa is a spa, massage and beauty centre in Sodeco, Achrafieh, Beirut. Massage, Moroccan bath, facials, manicure and more, open until 11 PM every day. Book on WhatsApp."
---

{% from "partials/media.njk" import frame %}
{% set wa = site.contact.whatsapp.link | whatsapp(site.contact.whatsapp.prefill) %}

<!-- ── Hero ─────────────────────────────────────────────────────────────── -->
{#
  The still sits underneath and paints immediately; the video fades in over it
  once it is actually playing. That way the hero is never empty, and when
  playback is suppressed — reduced motion, Save-Data, a slow connection, or no
  video support — what remains is a finished image rather than a gap.

  The video is decorative and silent: it carries no information the copy does
  not already give, which is why it is hidden from assistive technology and
  needs no captions.
#}
<section class="hero hero--film">
  <div class="hero__media">
    <img class="hero__still" src="{{ site.heroVideo.poster | url }}" alt="{{ site.images.hero.alt }}"
         width="{{ site.heroVideo.width }}" height="{{ site.heroVideo.height }}"
         fetchpriority="high" decoding="async">

    {% if site.heroVideo.enabled %}
    <video class="hero__video" data-hero-video
           data-webm="{{ site.heroVideo.webm | url }}" data-mp4="{{ site.heroVideo.mp4 | url }}"
           width="{{ site.heroVideo.width }}" height="{{ site.heroVideo.height }}"
           muted loop playsinline preload="none"
           aria-hidden="true" tabindex="-1" disablepictureinpicture></video>
    {% endif %}

    <span class="hero__scrim" aria-hidden="true"></span>
  </div>

  <div class="shell hero__inner">
    <p class="eyebrow eyebrow--on-film" data-reveal="type">{{ site.copy.home.heroEyebrow }}</p>
    <h1 class="display-1 hero__title" data-reveal="type" data-reveal-delay="1">
      {{ site.copy.home.heroTitle }}<br><em>{{ site.copy.home.heroTitleAccent }}</em>
    </h1>
    <p class="lead hero__lead">{{ site.copy.home.heroLead }}</p>
    <div class="hero__actions">
      <a class="btn btn--on-deep btn--lg" href="{{ wa }}" target="_blank" rel="noopener">Book on WhatsApp</a>
      <a class="btn btn--outline-film btn--lg" href="{{ "/treatments/" | url }}">See treatments</a>
    </div>
  </div>
</section>

<!-- ── Proof points ──────────────────────────────────────────────────────── -->
<section class="marks-strip">
  <div class="shell">
    <ul class="marks">
      {% for mark in site.copy.home.marks %}
      <li class="marks__item">
        <span class="marks__label">{{ mark.label }}</span>
        <span class="marks__value">{% if mark.value == 'auto' %}{{ site.serviceCount }}{% else %}{{ mark.value }}{% endif %}</span>
        <span class="marks__detail">{{ mark.detail }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<!-- ── Treatment categories ──────────────────────────────────────────────── -->
<section class="section section--raised" aria-labelledby="cats-title">
  <div class="shell">
    <header class="section-head">
      <p class="eyebrow eyebrow-rule">What we do</p>
      <h2 class="h1" id="cats-title" data-reveal="type">Three ways to spend an evening</h2>
    </header>

    <ul class="cats">
      {% for category in site.serviceCategories %}
      {% set img = site.images[category.image] %}
      <li>
        <a class="card card--link" href="{{ "/treatments/" | url }}#{{ category.id }}" data-reveal="media" data-reveal-delay="{{ loop.index }}">
          <span class="card__media">{{ frame(img, category.id) }}</span>
          <span class="card__body">
            <span class="cat__count">{{ category.services | length }} treatments</span>
            <span class="card__title">{{ category.name }}</span>
            <span class="card__text">{{ category.intro }}</span>
            <span class="card__foot">
              <span class="cat__more">See all<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M4 12h15m0 0-6-6m6 6-6 6"/></svg></span>
            </span>
          </span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<!-- ── Signature: the Moroccan bath ──────────────────────────────────────── -->
<section class="section section--alt" aria-labelledby="ritual-title">
  <div class="shell">
    <div class="split split--offset">

      <figure class="figure" data-reveal="media">
        <div class="figure__frame" style="aspect-ratio: 4 / 5;">
          {{ frame(site.images.hammam, 'hammam') }}
        </div>
      </figure>

      <div>
        <p class="eyebrow eyebrow-rule">The signature</p>
        <h2 class="display-2" style="margin-block: var(--s-4);" id="ritual-title" data-reveal="type">{{ site.copy.home.ritualTitle }}</h2>
        <p class="body-text" style="margin-bottom: var(--s-6);">{{ site.copy.home.ritualLead }}</p>

        {#
          Numbered because a hammam genuinely is a sequence — the order is the
          treatment. Not used for unordered lists anywhere else on the site.
        #}
        <ol class="steps">
          {% for step in site.copy.home.ritualSteps %}
          <li class="steps__item">
            <span class="steps__num" aria-hidden="true">{{ loop.index }}</span>
            <h3 class="steps__name">{{ step.name }}</h3>
            <p class="steps__text">{{ step.text }}</p>
          </li>
          {% endfor %}
        </ol>

        <div style="margin-top: var(--s-6);">
          <a class="btn btn--bronze"
             href="{{ site.contact.whatsapp.link | whatsapp('Moroccan Bath' | bookingMessage(site.business.name)) }}"
             target="_blank" rel="noopener">Book the Moroccan bath</a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ── Visit ─────────────────────────────────────────────────────────────── -->
<section class="section" aria-labelledby="visit-title">
  <div class="shell">
    <div class="split split--reverse">

      <figure class="figure" data-reveal="media">
        <div class="figure__frame" style="aspect-ratio: 16 / 10;">
          {{ frame(site.images.interior, 'interior') }}
        </div>
      </figure>

      <div>
        <p class="eyebrow eyebrow-rule">Visit</p>
        <h2 class="h1" style="margin-block: var(--s-4);" id="visit-title" data-reveal="type">Open late, every day</h2>

        <dl class="hours hours--lg" style="max-width: 26rem; margin-bottom: var(--s-5);">
          {% for group in site.hours.groups %}
          <div class="hours__row">
            <dt>{{ group.label }}</dt>
            <dd>{{ group.time }}</dd>
          </div>
          {% endfor %}
        </dl>

        {% if site.hours.note %}
        <p class="small muted" style="max-width: 42ch;">{{ site.hours.note }}</p>
        {% endif %}

        <address style="display: grid; gap: 0.15rem; margin-block: var(--s-5);">
          {% for line in site.contact.address.lines %}<span>{{ line }}</span>{% endfor %}
        </address>

        <a class="link" href="{{ "/visit/" | url }}">How to find us</a>
      </div>

    </div>
  </div>
</section>

<!-- ── Closing call to action ────────────────────────────────────────────── -->
<section class="section section--deep" aria-labelledby="closing-title">
  <div class="shell shell--narrow">
    <div class="section-head section-head--centre" style="margin-bottom: var(--s-6);">
      <p class="eyebrow eyebrow--on-deep">Booking</p>
      <h2 class="display-2" style="color: var(--ivory);" id="closing-title" data-reveal="type">{{ site.copy.home.closingTitle }}</h2>
      <p class="lead">{{ site.copy.home.closingLead }}</p>
    </div>
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3);">
      <a class="btn btn--on-deep btn--lg" href="{{ wa }}" target="_blank" rel="noopener">
        {{ site.contact.whatsapp.display }}
      </a>
      <a class="btn btn--secondary btn--lg" href="{{ site.contact.phone.link }}"
         style="border-color: var(--sand); color: var(--sand);">
        Call {{ site.contact.phone.display }}
      </a>
    </div>
  </div>
</section>
