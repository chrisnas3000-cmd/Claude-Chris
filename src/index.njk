---
layout: layouts/base.njk
permalink: /
bodyClass: page-home
description: "Teena'z Spa is a spa, massage and beauty centre in Sodeco, Achrafieh, Beirut. Massage, Moroccan bath, facials, manicure and more, open until 11 PM every day. Book on WhatsApp."
---

{% set wa = site.contact.whatsapp.link | whatsapp(site.contact.whatsapp.prefill) %}

<!-- ── Hero ─────────────────────────────────────────────────────────────── -->
<section class="hero">
  <div class="hero__media">
    <img src="{{ site.images.hero.src }}" alt="{{ site.images.hero.alt }}"
         width="1600" height="1100" fetchpriority="high" decoding="async">
    <span class="hero__veil" aria-hidden="true"></span>
  </div>

  <div class="shell hero__inner">
    <p class="eyebrow reveal" data-reveal>{{ site.copy.home.heroEyebrow }}</p>
    <h1 class="hero__title">
      <span class="reveal" data-reveal data-reveal-delay="1">{{ site.copy.home.heroTitle }}</span>
      <em class="reveal" data-reveal data-reveal-delay="2">{{ site.copy.home.heroTitleAccent }}</em>
    </h1>
    <p class="hero__lead reveal" data-reveal data-reveal-delay="3">{{ site.copy.home.heroLead }}</p>

    <div class="hero__actions reveal" data-reveal data-reveal-delay="4">
      <a class="btn btn--brass" href="{{ wa }}" target="_blank" rel="noopener">Book on WhatsApp</a>
      <a class="btn btn--ghost" href="/treatments/">See treatments</a>
    </div>
  </div>

  <ul class="marks">
    {% for mark in site.copy.home.marks %}
    <li class="marks__item reveal" data-reveal data-reveal-delay="{{ loop.index + 4 }}">
      <span class="marks__label">{{ mark.label }}</span>
      <span class="marks__value">{% if mark.value == 'auto' %}{{ site.serviceCount }}{% else %}{{ mark.value }}{% endif %}</span>
      <span class="marks__detail">{{ mark.detail }}</span>
    </li>
    {% endfor %}
  </ul>
</section>

<!-- ── Treatment categories ──────────────────────────────────────────────── -->
<section class="section section--plaster" aria-labelledby="cats-title">
  <div class="shell">
    <header class="section__head">
      <p class="eyebrow eyebrow--dark">What we do</p>
      <h2 class="section__title" id="cats-title">Three ways to spend an evening</h2>
    </header>

    <ul class="cats">
      {% for category in site.serviceCategories %}
      {% set img = site.images[category.image] %}
      <li class="cat reveal" data-reveal data-reveal-delay="{{ loop.index }}">
        <a class="cat__link" href="/treatments/#{{ category.id }}">
          <span class="cat__media">
            <img src="{{ img.src }}" alt="{{ img.alt }}" width="900" height="1200" loading="lazy" decoding="async">
          </span>
          <span class="cat__body">
            <span class="cat__count">{{ category.services | length }} treatments</span>
            <span class="cat__name">{{ category.name }}</span>
            <span class="cat__intro">{{ category.intro }}</span>
            <span class="cat__more">See all<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 12h15m0 0-6-6m6 6-6 6"/></svg></span>
          </span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<!-- ── Signature: the Moroccan bath ──────────────────────────────────────── -->
<section class="ritual" aria-labelledby="ritual-title">
  <div class="shell ritual__inner">

    <div class="ritual__intro">
      <p class="eyebrow">The signature</p>
      <h2 class="ritual__title" id="ritual-title">{{ site.copy.home.ritualTitle }}</h2>
      <p class="ritual__lead">{{ site.copy.home.ritualLead }}</p>
      <a class="btn btn--brass" href="{{ site.contact.whatsapp.link | whatsapp('Moroccan Bath' | bookingMessage(site.business.name)) }}"
         target="_blank" rel="noopener">Book the Moroccan bath</a>
    </div>

    {#
      Numbered because a hammam genuinely is a sequence — the order is the
      treatment. Do not reuse this pattern for lists that are not ordered.
    #}
    <ol class="steps">
      {% for step in site.copy.home.ritualSteps %}
      <li class="steps__item reveal" data-reveal data-reveal-delay="{{ loop.index }}">
        <span class="steps__num" aria-hidden="true">{{ loop.index }}</span>
        <h3 class="steps__name">{{ step.name }}</h3>
        <p class="steps__text">{{ step.text }}</p>
      </li>
      {% endfor %}
    </ol>

  </div>

  <div class="ritual__tile" aria-hidden="true"
       style="background-image:url('{{ site.images.hammam.src }}')"></div>
</section>

<!-- ── Visit ─────────────────────────────────────────────────────────────── -->
<section class="section section--plaster visit-strip" aria-labelledby="visit-title">
  <div class="shell visit-strip__grid">

    <div class="visit-strip__text">
      <p class="eyebrow eyebrow--dark">Visit</p>
      <h2 class="section__title" id="visit-title">Open late, every day</h2>
      <dl class="hours hours--lg">
        {% for group in site.hours.groups %}
        <div class="hours__row">
          <dt>{{ group.label }}</dt>
          <dd>{{ group.time }}</dd>
        </div>
        {% endfor %}
      </dl>
      {% if site.hours.note %}<p class="visit-strip__note">{{ site.hours.note }}</p>{% endif %}

      <address class="visit-strip__address">
        {% for line in site.contact.address.lines %}<span>{{ line }}</span>{% endfor %}
      </address>
      <a class="link-arrow" href="/visit/">How to find us<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 12h15m0 0-6-6m6 6-6 6"/></svg></a>
    </div>

    <figure class="visit-strip__figure reveal" data-reveal>
      <img src="{{ site.images.interior.src }}" alt="{{ site.images.interior.alt }}"
           width="1600" height="900" loading="lazy" decoding="async">
    </figure>

  </div>
</section>

<!-- ── Closing call to action ────────────────────────────────────────────── -->
<section class="closing" aria-labelledby="closing-title">
  <div class="shell closing__inner">
    <span class="closing__arch" aria-hidden="true"></span>
    <h2 class="closing__title" id="closing-title">{{ site.copy.home.closingTitle }}</h2>
    <p class="closing__lead">{{ site.copy.home.closingLead }}</p>
    <div class="closing__actions">
      <a class="btn btn--brass btn--lg" href="{{ wa }}" target="_blank" rel="noopener">
        {{ site.contact.whatsapp.display }}
      </a>
      <a class="btn btn--ghost btn--lg" href="{{ site.contact.phone.link }}">
        Call {{ site.contact.phone.display }}
      </a>
    </div>
  </div>
</section>
