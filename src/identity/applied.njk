---
layout: layouts/identity.njk
permalink: /identity/applied/
title: Applied page
description: The Teenaz Spa visual identity composed as a full page, using placeholder content only.
---

{#
  The system, assembled. Every word here is placeholder — this page exists to
  show atmosphere, rhythm and how the components sit together, not to propose
  any copy.
#}

<!-- ── Hero ─────────────────────────────────────────────────────────────── -->
<section class="section" style="padding-top: var(--s-7);">
  <div class="shell">
    <div class="split" style="align-items: end;">
      <div class="stack--lg stack">
        <p class="eyebrow eyebrow-rule" data-reveal="type">Placeholder eyebrow</p>
        <h1 class="display-1" data-reveal="type" data-reveal-delay="1">
          A quiet hour,<br><em>kept for you</em>
        </h1>
        <p class="lead">
          Placeholder introductory sentence. Two lines at most, sitting under the
          statement without competing with it.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: var(--s-3);">
          <a class="btn btn--primary btn--lg" href="#applied-form">Placeholder action</a>
          <a class="btn btn--secondary btn--lg" href="#applied-services">Placeholder action</a>
        </div>
      </div>

      <figure class="figure ken" data-reveal="media" data-reveal-delay="2">
        <div class="figure__frame" style="aspect-ratio: 4 / 5;">
          <canvas data-media="applied-hero" data-tone="warm" aria-hidden="true"></canvas>
        </div>
      </figure>
    </div>
  </div>
</section>

<!-- ── Quiet editorial statement ────────────────────────────────────────── -->
<section class="section section--raised">
  <div class="shell shell--narrow">
    <div class="section-head section-head--centre" style="margin-bottom: 0;">
      <p class="eyebrow" data-reveal="type">Placeholder label</p>
      <h2 class="display-2" data-reveal="type" data-reveal-delay="1" style="max-width: 20ch;">
        Placeholder statement set across two lines
      </h2>
      <p class="body-text" style="margin-inline: auto;">
        {{ identity.placeholder.paragraph }}
      </p>
    </div>
  </div>
</section>

<!-- ── Services ─────────────────────────────────────────────────────────── -->
<section class="section" id="applied-services" aria-labelledby="applied-services-t">
  <div class="shell">
    <header class="section-head">
      <p class="eyebrow eyebrow-rule">Placeholder label</p>
      <h2 class="h1" id="applied-services-t">Placeholder section heading</h2>
      <p class="body-text">{{ identity.placeholder.sentence }}</p>
    </header>

    <div class="grid-3">
      {% for tone in ['warm', 'bronze', 'steam'] %}
      <a class="card card--link" href="#applied-services" data-reveal="media" data-reveal-delay="{{ loop.index }}">
        <span class="card__media">
          <canvas data-media="applied-svc-{{ loop.index }}" data-tone="{{ tone }}" aria-hidden="true"></canvas>
        </span>
        <span class="card__body">
          <span class="eyebrow">Placeholder label</span>
          <span class="card__title">{{ identity.placeholder.cardTitle }}</span>
          <span class="card__text">{{ identity.placeholder.cardText }}</span>
          <span class="card__foot"><span class="link">Placeholder link</span></span>
        </span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ── Editorial split ──────────────────────────────────────────────────── -->
<section class="section section--alt">
  <div class="shell">
    <div class="split split--reverse split--offset">
      <figure class="figure" data-reveal="media">
        <div class="figure__frame" style="aspect-ratio: 3 / 4;">
          <canvas data-media="applied-editorial" data-tone="stone" aria-hidden="true"></canvas>
        </div>
      </figure>
      <div class="stack--lg stack">
        <p class="eyebrow">Placeholder label</p>
        <h2 class="display-2">Placeholder heading</h2>
        <p class="body-text">{{ identity.placeholder.paragraph }}</p>
        <p class="body-text">{{ identity.placeholder.paragraph }}</p>
        <div><a class="btn btn--secondary" href="#applied-form">Placeholder action</a></div>
      </div>
    </div>
  </div>
</section>

<!-- ── Full-width band ──────────────────────────────────────────────────── -->
<section class="section">
  <div class="shell">
    <div class="overlay-media ken" data-reveal="media">
      <canvas data-media="applied-band" data-tone="deep" aria-hidden="true" style="position: absolute; inset: 0; width: 100%; height: 100%;"></canvas>
      <span class="overlay-media__scrim"></span>
      <div class="overlay-media__content" style="min-height: 32rem; padding: var(--s-8) var(--s-7);">
        <p class="eyebrow eyebrow--on-deep">Placeholder label</p>
        <h2 class="display-2" style="color: var(--ivory); max-width: 16ch;">Placeholder statement</h2>
        <p class="lead" style="max-width: 42ch;">{{ identity.placeholder.sentence }}</p>
        <div><a class="btn btn--on-deep" href="#applied-form">Placeholder action</a></div>
      </div>
    </div>
  </div>
</section>

<!-- ── Testimonials ─────────────────────────────────────────────────────── -->
<section class="section section--raised" aria-labelledby="applied-quotes-t">
  <div class="shell">
    <header class="section-head section-head--centre">
      <p class="eyebrow">Placeholder label</p>
      <h2 class="h1" id="applied-quotes-t">Placeholder section heading</h2>
    </header>

    <div class="grid-3">
      {% for i in [1, 2, 3] %}
      <figure class="quote" data-reveal="media" data-reveal-delay="{{ i }}">
        <span class="quote__mark" aria-hidden="true">&ldquo;</span>
        <blockquote class="quote__text">Placeholder testimonial running to about the length of a real one.</blockquote>
        <figcaption class="quote__by">
          <span class="quote__avatar"><canvas data-media="applied-av-{{ i }}" data-tone="sage" aria-hidden="true"></canvas></span>
          <span>
            <span class="quote__name">Placeholder name</span><br>
            <span class="quote__role">Placeholder detail</span>
          </span>
        </figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ── Gallery ──────────────────────────────────────────────────────────── -->
<section class="section">
  <div class="shell">
    <header class="section-head">
      <p class="eyebrow eyebrow-rule">Placeholder label</p>
      <h2 class="h1">Placeholder section heading</h2>
    </header>
    <div class="gallery">
      {% for tone in ['bronze', 'steam', 'warm', 'stone', 'sage'] %}
      <figure class="gallery__item" data-reveal="media" data-reveal-delay="{{ loop.index }}">
        <canvas data-media="applied-gal-{{ loop.index }}" data-tone="{{ tone }}" aria-hidden="true"></canvas>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ── Accordion ────────────────────────────────────────────────────────── -->
<section class="section section--alt">
  <div class="shell shell--narrow">
    <header class="section-head">
      <p class="eyebrow eyebrow-rule">Placeholder label</p>
      <h2 class="h1">Placeholder section heading</h2>
    </header>

    <div class="accordion">
      {% for i in [1, 2, 3, 4, 5] %}
      <div class="accordion__item">
        <h3>
          <button class="accordion__trigger" type="button"
                  aria-expanded="{% if i == 1 %}true{% else %}false{% endif %}"
                  aria-controls="applied-panel-{{ i }}" data-accordion-trigger>
            <span>Placeholder question {{ i }}</span>
            <span class="accordion__sign" aria-hidden="true"></span>
          </button>
        </h3>
        <div class="accordion__panel" id="applied-panel-{{ i }}"
             data-open="{% if i == 1 %}true{% else %}false{% endif %}">
          <div><p class="accordion__body">{{ identity.placeholder.paragraph }}</p></div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ── Location and form ────────────────────────────────────────────────── -->
<section class="section" id="applied-form" aria-labelledby="applied-form-t">
  <div class="shell">
    <header class="section-head">
      <p class="eyebrow eyebrow-rule">Placeholder label</p>
      <h2 class="h1" id="applied-form-t">Placeholder section heading</h2>
    </header>

    <div class="split" style="align-items: start;">
      <div class="map" data-reveal="media">
        <canvas data-media="applied-map" data-tone="sage" aria-hidden="true"></canvas>
        <div class="map__card">
          <p class="eyebrow">Placeholder label</p>
          <p class="h4">Placeholder location</p>
          <p class="small muted">Placeholder address line<br>Placeholder address line</p>
          <a class="link small" href="#applied-form">Placeholder link</a>
        </div>
      </div>

      <form class="form">
        <div class="field">
          <label class="field__label" for="a-name">Placeholder label</label>
          <input class="field__control" id="a-name" type="text" placeholder="Placeholder text">
        </div>
        <div class="field">
          <label class="field__label" for="a-contact">Placeholder label</label>
          <input class="field__control" id="a-contact" type="text" placeholder="Placeholder text">
        </div>
        <div class="field">
          <label class="field__label" for="a-note">Placeholder label</label>
          <textarea class="field__control" id="a-note" placeholder="Placeholder text"></textarea>
        </div>
        <label class="check">
          <input type="checkbox">
          <span class="check__text">Placeholder consent line.</span>
        </label>
        <div><button class="btn btn--primary btn--lg btn--block" type="button">Placeholder submit</button></div>
      </form>
    </div>
  </div>
</section>
