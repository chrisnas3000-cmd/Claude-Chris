---
layout: layouts/base.njk
permalink: /treatments/
title: Treatments
bodyClass: page-treatments
description: "Massage, body treatments and beauty services at Teena'z Spa in Achrafieh, Beirut — including Moroccan bath, deep tissue massage, facials, waxing and laser. Book on WhatsApp."
---

<section class="page-head">
  <div class="shell">
    <p class="eyebrow">{{ site.serviceCount }} treatments</p>
    <h1 class="page-head__title">{{ site.copy.services.title }}</h1>
    <p class="page-head__lead">{{ site.copy.services.lead }}</p>

    <nav class="jump" aria-label="Treatment categories">
      {% for category in site.serviceCategories %}
      <a class="jump__link" href="#{{ category.id }}">{{ category.name }}</a>
      {% endfor %}
    </nav>
  </div>
</section>

{% for category in site.serviceCategories %}
{% set img = site.images[category.image] %}
<section class="cat-block {% if loop.index is odd %}cat-block--plaster{% else %}cat-block--dark{% endif %}"
         id="{{ category.id }}" aria-labelledby="{{ category.id }}-title">
  <div class="shell">

    <header class="cat-block__head">
      <figure class="cat-block__figure reveal" data-reveal>
        <img src="{{ img.src }}" alt="{{ img.alt }}" width="900" height="1200" loading="lazy" decoding="async">
      </figure>
      <div class="cat-block__intro">
        <p class="eyebrow {% if loop.index is odd %}eyebrow--dark{% endif %}">
          {{ category.services | length }} treatments
        </p>
        <h2 class="cat-block__title" id="{{ category.id }}-title">{{ category.name }}</h2>
        <p class="cat-block__lead">{{ category.intro }}</p>
      </div>
    </header>

    <ul class="services">
      {% for service in category.services %}
      <li class="service {% if service.featured %}service--featured{% endif %} reveal"
          data-reveal data-reveal-delay="{{ loop.index }}">
        <div class="service__text">
          <h3 class="service__name">
            {{ service.name }}
            {% if service.featured %}<span class="service__flag">Signature</span>{% endif %}
          </h3>
          {% if service.duration or service.price %}
          <p class="service__meta">
            {% if service.duration %}<span>{{ service.duration }}</span>{% endif %}
            {% if service.price %}<span>{{ service.price }}</span>{% endif %}
          </p>
          {% endif %}
          <p class="service__blurb">{{ service.blurb }}</p>
        </div>
        <a class="service__book"
           href="{{ site.contact.whatsapp.link | whatsapp(service.name | bookingMessage(site.business.name)) }}"
           target="_blank" rel="noopener">
          <span>Book</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 12h15m0 0-6-6m6 6-6 6"/></svg>
          <span class="sr-only">{{ service.name }} on WhatsApp</span>
        </a>
      </li>
      {% endfor %}
    </ul>

  </div>
</section>
{% endfor %}

<section class="closing" aria-labelledby="t-closing">
  <div class="shell closing__inner">
    <span class="closing__arch" aria-hidden="true"></span>
    <h2 class="closing__title" id="t-closing">Not sure which one?</h2>
    <p class="closing__lead">Message us with roughly what you are after and we will point you at the right treatment.</p>
    <div class="closing__actions">
      <a class="btn btn--brass btn--lg"
         href="{{ site.contact.whatsapp.link | whatsapp(site.contact.whatsapp.prefill) }}"
         target="_blank" rel="noopener">Ask on WhatsApp</a>
      <a class="btn btn--ghost btn--lg" href="{{ site.contact.phone.link }}">Call {{ site.contact.phone.display }}</a>
    </div>
  </div>
</section>
