---
layout: layouts/base.njk
permalink: /treatments/
title: Treatments
bodyClass: page-treatments
description: "Massage, body treatments and beauty services at Teena'z Spa in Achrafieh, Beirut — including Moroccan bath, deep tissue massage, facials, waxing and laser. Book on WhatsApp."
---

{% from "partials/media.njk" import frame %}

<section class="page-head">
  <div class="shell">
    <p class="eyebrow eyebrow-rule" data-reveal="type">{{ site.serviceCount }} treatments</p>
    <h1 class="display-2 page-head__title" data-reveal="type" data-reveal-delay="1">{{ site.copy.services.title }}</h1>
    <p class="lead">{{ site.copy.services.lead }}</p>

    <nav class="jump" aria-label="Treatment categories">
      {% for category in site.serviceCategories %}
      <a class="jump__link" href="#{{ category.id }}">{{ category.name }}</a>
      {% endfor %}
    </nav>
  </div>
</section>

{% for category in site.serviceCategories %}
{% set img = site.images[category.image] %}
<section class="section {% if loop.index is even %}section--raised{% endif %}"
         id="{{ category.id }}" aria-labelledby="{{ category.id }}-title">
  <div class="shell">

    <div class="split" style="align-items: center; margin-bottom: var(--s-7);">
      <div>
        <p class="eyebrow eyebrow-rule">{{ category.services | length }} treatments</p>
        <h2 class="h1" style="margin-block: var(--s-4);" id="{{ category.id }}-title" data-reveal="type">{{ category.name }}</h2>
        <p class="body-text">{{ category.intro }}</p>
      </div>
      <figure class="figure" data-reveal="media">
        <div class="figure__frame" style="aspect-ratio: 3 / 2;">
          {{ frame(img, category.id) }}
        </div>
      </figure>
    </div>

    <ul class="services">
      {% for service in category.services %}
      <li class="service"-delay="{{ loop.index }}">
        <div class="service__text">
          <h3 class="service__name">
            {{ service.name }}
            {% if service.featured %}<span class="service__flag">Signature</span>{% endif %}
          </h3>
          {% if service.duration or service.price %}
          <p class="service__meta">
            {% if service.duration %}<span>{{ service.duration }}</span>{% endif %}
            {% if service.price %}<span>{{ service.price }}</span>{% endif %}
          </p>
          {% endif %}
          <p class="service__blurb">{{ service.blurb }}</p>
        </div>
        <a class="service__book"
           href="{{ site.contact.whatsapp.link | whatsapp(service.name | bookingMessage(site.business.name)) }}"
           target="_blank" rel="noopener">
          <span>Book</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M4 12h15m0 0-6-6m6 6-6 6"/></svg>
          <span class="sr-only">{{ service.name }} on WhatsApp</span>
        </a>
      </li>
      {% endfor %}
    </ul>

  </div>
</section>
{% endfor %}

<section class="section section--deep" aria-labelledby="t-closing">
  <div class="shell shell--narrow">
    <div class="section-head section-head--centre" style="margin-bottom: var(--s-6);">
      <p class="eyebrow eyebrow--on-deep">Not sure?</p>
      <h2 class="display-2" style="color: var(--ivory);" id="t-closing">Not sure which one?</h2>
      <p class="lead">Message us with roughly what you are after and we will point you at the right treatment.</p>
    </div>
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3);">
      <a class="btn btn--on-deep btn--lg"
         href="{{ site.contact.whatsapp.link | whatsapp(site.contact.whatsapp.prefill) }}"
         target="_blank" rel="noopener">Ask on WhatsApp</a>
      <a class="btn btn--secondary btn--lg" href="{{ site.contact.phone.link }}"
         style="border-color: var(--sand); color: var(--sand);">Call {{ site.contact.phone.display }}</a>
    </div>
  </div>
</section>
