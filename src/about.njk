---
layout: layouts/base.njk
permalink: /about/
title: About
bodyClass: page-about
description: "About Teena'z Spa — a spa, massage and beauty centre in Sodeco, Achrafieh, Beirut, open until 11 PM seven days a week."
---

{% from "partials/media.njk" import frame with context %}

<section class="page-head">
  <div class="shell">
    <p class="eyebrow eyebrow-rule" data-reveal="type">About</p>
    <h1 class="display-2 page-head__title" data-reveal="type" data-reveal-delay="1">{{ site.copy.about.title }}</h1>
    <p class="lead">{{ site.copy.about.lead }}</p>
  </div>
</section>

<section class="section section--raised">
  <div class="shell">
    <div class="split" style="align-items: start;">

      <div class="stack--lg stack">
        {% for paragraph in site.copy.about.body %}
        <p class="body-text">{{ paragraph }}</p>
        {% endfor %}
      </div>

      <aside class="card card--sand" data-reveal="media">
        <div class="card__body">
          <h2 class="h4">In short</h2>
          <ul class="do-dont__list" style="font-size: var(--t-small);">
            {% for point in site.copy.about.points %}<li>{{ point }}</li>{% endfor %}
          </ul>
          <div class="card__foot"><a class="link small" href="{{ "/treatments/" | url }}">See the treatment list</a></div>
        </div>
      </aside>

    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <figure class="figure ken" data-reveal="media">
      <div class="figure__frame" style="aspect-ratio: 21 / 9;">
        {{ frame(site.images.interior, 'about-interior') }}
      </div>
    </figure>
  </div>
</section>

<section class="section section--deep" aria-labelledby="a-closing">
  <div class="shell shell--narrow">
    <div class="section-head section-head--centre" style="margin-bottom: var(--s-6);">
      <p class="eyebrow eyebrow--on-deep">Booking</p>
      <h2 class="display-2" style="color: var(--ivory);" id="a-closing">Come by this evening</h2>
      <p class="lead">Open until 11 PM, seven days a week. Message us and we will find you a time.</p>
    </div>
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3);">
      <a class="btn btn--on-deep btn--lg"
         href="{{ site.contact.whatsapp.link | whatsapp(site.contact.whatsapp.prefill) }}"
         target="_blank" rel="noopener">Book on WhatsApp</a>
      <a class="btn btn--secondary btn--lg" href="{{ "/visit/" | url }}"
         style="border-color: var(--sand); color: var(--sand);">Find us</a>
    </div>
  </div>
</section>
