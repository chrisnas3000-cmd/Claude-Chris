---
layout: layouts/base.njk
permalink: /about/
title: About
bodyClass: page-about
description: "About Teena'z Spa — a spa, massage and beauty centre in Sodeco, Achrafieh, Beirut, open until 11 PM seven days a week."
---

<section class="page-head">
  <div class="shell">
    <p class="eyebrow">About</p>
    <h1 class="page-head__title">{{ site.copy.about.title }}</h1>
    <p class="page-head__lead">{{ site.copy.about.lead }}</p>
  </div>
</section>

<section class="section section--plaster">
  <div class="shell prose-grid">

    <div class="prose">
      {% for paragraph in site.copy.about.body %}
      <p class="reveal" data-reveal data-reveal-delay="{{ loop.index }}">{{ paragraph }}</p>
      {% endfor %}
    </div>

    <aside class="facts reveal" data-reveal>
      <h2 class="facts__title">In short</h2>
      <ul class="facts__list">
        {% for point in site.copy.about.points %}
        <li>{{ point }}</li>
        {% endfor %}
      </ul>
      <a class="link-arrow link-arrow--dark" href="/treatments/">
        See the treatment list<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 12h15m0 0-6-6m6 6-6 6"/></svg>
      </a>
    </aside>

  </div>
</section>

<section class="band">
  <figure class="band__figure">
    <img src="{{ site.images.interior.src }}" alt="{{ site.images.interior.alt }}"
         width="1600" height="900" loading="lazy" decoding="async">
  </figure>
</section>

<section class="closing" aria-labelledby="a-closing">
  <div class="shell closing__inner">
    <span class="closing__arch" aria-hidden="true"></span>
    <h2 class="closing__title" id="a-closing">Come by this evening</h2>
    <p class="closing__lead">Open until 11 PM, seven days a week. Message us and we will find you a time.</p>
    <div class="closing__actions">
      <a class="btn btn--brass btn--lg"
         href="{{ site.contact.whatsapp.link | whatsapp(site.contact.whatsapp.prefill) }}"
         target="_blank" rel="noopener">Book on WhatsApp</a>
      <a class="btn btn--ghost btn--lg" href="/visit/">Find us</a>
    </div>
  </div>
</section>
